# APP
APP_ENV=development
APP_URL=http://localhost:8080
CLIENT_URL=http://localhost:5173

# Vite: khi chạy riêng client, đặt trong client/.env.local (không commit)
VITE_API_URL=http://localhost:8080
# Chọn http để thử backend thật trong development; production luôn HTTP
VITE_ORDER_API_MODE=http

# MYSQL
# Opt-in only after baseline + migrations 008_order_runtime.sql, 013_checkout_runtime.sql, 014_vnpay_runtime.sql and auth review.
# mysql enables order/cart/checkout runtime after the listed migrations and owner integrations are ready.
# Cart write API and catalog-to-SKU integration are still owned by the cart/catalog tasks.
ORDER_STORAGE_MODE=disabled
DB_HOST=db
DB_PORT=3306
DB_NAME=household_ecommerce
DB_USER=app_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_me

# AUTH: phiên PHP + MySQL; APP_ENV=production tắt mã khôi phục mật khẩu hiển thị trên trang.
JWT_SECRET=change_this_secret

# VNPAY
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/orders/payment-return
VNPAY_IPN_URL=

# EMAIL
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
