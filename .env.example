# APP
APP_ENV=development
APP_URL=http://localhost:8080
CLIENT_URL=http://localhost:5173

# Vite: khi chạy riêng client, đặt trong client/.env.local (không commit)
VITE_API_URL=http://localhost:8080
# Chọn http để thử backend thật trong development; production luôn HTTP
VITE_ORDER_API_MODE=http

# MYSQL
# Opt-in after baseline + migrations 008_order_runtime/014_payment_ledger and configuration review.
# mysql enables HTTP checkout/cart/payment; configure shipping and receiving bank/merchant first.
ORDER_STORAGE_MODE=disabled
DB_HOST=db
DB_PORT=3306
DB_NAME=household_ecommerce
DB_USER=app_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_me

# AUTH: phiên PHP + MySQL; APP_ENV=production tắt mã khôi phục mật khẩu hiển thị trên trang.
JWT_SECRET=change_this_secret

# VNPAY
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# Tai khoan nhan chuyen khoan da duoc nhom duyet; khong dat trong VITE_*.
BANK_TRANSFER_BIN=
BANK_TRANSFER_ACCOUNT_NO=
BANK_TRANSFER_ACCOUNT_NAME=
# Phi giao hang VND do nhom chot; bo trong thi checkout tu choi tinh phi.
CHECKOUT_SHIPPING_VND=
# Khong mien phi neu de trong. Neu co, xet theo subtotal truoc giam gia.
CHECKOUT_FREE_SHIPPING_MIN_VND=
STORE_NAME=HomeCare
STORE_ADDRESS=
STORE_PHONE=

# EMAIL
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
